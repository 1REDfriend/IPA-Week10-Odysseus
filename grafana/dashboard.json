          "editorMode": "code",
          "expr": "sum(rate(epimetheus_requests_total{outcome=\"ok\"}[1m])) / sum(rate(epimetheus_requests_total[1m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
